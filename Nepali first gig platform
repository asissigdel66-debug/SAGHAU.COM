<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>SAGHAU — Find Instant Helpers. Make Instant Cash.</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=Syne:wght@700;800&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --pink:#FF2D78;
  --purple:#8B2FC9;
  --blue:#4F46E5;
  --grad:linear-gradient(135deg,#FF2D78 0%,#C026A8 40%,#8B2FC9 70%,#4F46E5 100%);
  --grad2:linear-gradient(135deg,#4F46E5 0%,#8B2FC9 50%,#FF2D78 100%);
  --soft:linear-gradient(135deg,rgba(255,45,120,0.12) 0%,rgba(139,47,201,0.10) 50%,rgba(79,70,229,0.10) 100%);
  --white:#ffffff;
  --off:#f8f7ff;
  --text:#0f0a1e;
  --muted:#6b7280;
  --radius:20px;
}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--white);color:var(--text);overflow-x:hidden}

/* ── SCROLLBAR ── */
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:#f1f1f1}
::-webkit-scrollbar-thumb{background:var(--grad);border-radius:10px}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  padding:1rem 5%;
  display:flex;align-items:center;justify-content:space-between;
  background:rgba(255,255,255,0.85);
  backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(139,47,201,0.08);
  transition:all 0.3s;
}
.nav-logo{display:flex;align-items:center;gap:0.7rem;text-decoration:none}
.nav-logo img{width:42px;height:42px;border-radius:10px;object-fit:cover}
.nav-logo-text{font-family:'Syne',sans-serif;font-size:1.4rem;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.nav-links{display:flex;align-items:center;gap:2rem}
.nav-links a{text-decoration:none;color:var(--muted);font-weight:500;font-size:0.9rem;transition:color 0.2s}
.nav-links a:hover{color:var(--purple)}
.nav-cta{
  background:var(--grad);color:#fff;border:none;
  padding:0.6rem 1.4rem;border-radius:999px;font-size:0.85rem;font-weight:700;
  cursor:pointer;transition:transform 0.2s,box-shadow 0.2s;font-family:inherit;
  box-shadow:0 4px 15px rgba(139,47,201,0.3);
}
.nav-cta:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(139,47,201,0.4)}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px}
.hamburger span{width:24px;height:2px;background:var(--purple);border-radius:2px;transition:all 0.3s}

/* ── HERO ── */
.hero{
  min-height:100vh;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:8rem 5% 5rem;
  position:relative;overflow:hidden;
  background:radial-gradient(ellipse 100% 80% at 50% 0%,rgba(139,47,201,0.08) 0%,transparent 60%);
}
.hero-bg-orb{
  position:absolute;border-radius:50%;filter:blur(80px);pointer-events:none;
}
.orb1{width:500px;height:500px;background:radial-gradient(circle,rgba(255,45,120,0.18),transparent 70%);top:-100px;left:-150px;animation:orbFloat 10s ease-in-out infinite alternate}
.orb2{width:600px;height:600px;background:radial-gradient(circle,rgba(79,70,229,0.15),transparent 70%);bottom:-150px;right:-200px;animation:orbFloat 12s 2s ease-in-out infinite alternate}
.orb3{width:300px;height:300px;background:radial-gradient(circle,rgba(139,47,201,0.12),transparent 70%);top:40%;left:50%;transform:translate(-50%,-50%);animation:orbFloat 8s 1s ease-in-out infinite alternate}
@keyframes orbFloat{from{transform:translate(0,0)}to{transform:translate(30px,40px)}}

.hero-badge{
  display:inline-flex;align-items:center;gap:0.5rem;
  background:rgba(139,47,201,0.08);border:1px solid rgba(139,47,201,0.2);
  color:var(--purple);padding:0.5rem 1.2rem;border-radius:999px;font-size:0.78rem;font-weight:600;
  letter-spacing:0.08em;text-transform:uppercase;margin-bottom:1.5rem;
  animation:slideDown 0.7s ease both;
}
.badge-pulse{width:7px;height:7px;background:var(--pink);border-radius:50%;animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.4);opacity:0.6}}

.hero-logo{
  width:120px;height:120px;object-fit:cover;border-radius:24px;
  margin-bottom:1.5rem;
  box-shadow:0 20px 60px rgba(139,47,201,0.35),0 0 0 1px rgba(255,255,255,0.5);
  animation:slideDown 0.7s 0.1s ease both;
}

h1.hero-title{
  font-family:'Syne',sans-serif;font-size:clamp(4rem,12vw,8rem);font-weight:800;
  background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  line-height:1;margin-bottom:0.5rem;
  animation:slideDown 0.7s 0.2s ease both;
}
.hero-sub{
  font-size:clamp(1.2rem,4vw,1.9rem);font-weight:700;color:var(--text);
  margin-bottom:1rem;animation:slideDown 0.7s 0.3s ease both;
}
.hero-sub span{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-desc{
  font-size:1rem;color:var(--muted);max-width:520px;line-height:1.7;
  margin:0 auto 2.5rem;animation:slideDown 0.7s 0.4s ease both;
}

.hero-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-bottom:3rem;animation:slideDown 0.7s 0.5s ease both}
.btn-primary{
  background:var(--grad);color:#fff;border:none;
  padding:1rem 2rem;border-radius:999px;font-size:1rem;font-weight:700;
  cursor:pointer;font-family:inherit;transition:transform 0.2s,box-shadow 0.2s;
  box-shadow:0 8px 30px rgba(139,47,201,0.35);
}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 15px 40px rgba(139,47,201,0.45)}
.btn-secondary{
  background:transparent;color:var(--purple);
  border:2px solid;border-image:var(--grad) 1;
  padding:0.95rem 2rem;border-radius:999px;font-size:1rem;font-weight:700;
  cursor:pointer;font-family:inherit;transition:all 0.2s;
  /* gradient border hack */
  border:none;outline:2px solid transparent;
  background:linear-gradient(white,white) padding-box,var(--grad) border-box;
  border:2px solid transparent;
}
.btn-secondary:hover{background:var(--soft) padding-box,var(--grad) border-box;transform:translateY(-2px)}

/* feature badges */
.hero-badges{display:flex;flex-wrap:wrap;gap:0.75rem;justify-content:center;animation:slideDown 0.7s 0.6s ease both}
.hbadge{
  display:flex;align-items:center;gap:0.4rem;
  background:rgba(255,255,255,0.8);backdrop-filter:blur(12px);
  border:1px solid rgba(139,47,201,0.12);
  padding:0.5rem 1rem;border-radius:999px;font-size:0.8rem;font-weight:600;color:var(--text);
  box-shadow:0 2px 12px rgba(0,0,0,0.06);
}
.hbadge .check{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-weight:800}

@keyframes slideDown{from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:translateY(0)}}

/* ── SCROLL INDICATOR ── */
.scroll-ind{
  position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:0.3rem;
  color:var(--muted);font-size:0.72rem;letter-spacing:0.1em;text-transform:uppercase;
}
.scroll-line{width:1px;height:40px;background:var(--grad);animation:scrollAnim 1.5s ease infinite}
@keyframes scrollAnim{0%,100%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1)}}

/* ── SECTIONS COMMON ── */
section{padding:6rem 5%}
.section-label{
  display:inline-block;background:var(--soft);
  color:var(--purple);font-size:0.75rem;font-weight:700;letter-spacing:0.15em;
  text-transform:uppercase;padding:0.4rem 1rem;border-radius:999px;margin-bottom:1rem;
  border:1px solid rgba(139,47,201,0.15);
}
.section-title{font-family:'Syne',sans-serif;font-size:clamp(1.8rem,5vw,3rem);font-weight:800;line-height:1.15;margin-bottom:1rem}
.section-title span{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.section-desc{color:var(--muted);max-width:500px;line-height:1.7;font-size:0.97rem}

/* glass card */
.glass{
  background:rgba(255,255,255,0.7);backdrop-filter:blur(20px);
  border:1px solid rgba(139,47,201,0.1);border-radius:var(--radius);
  box-shadow:0 8px 32px rgba(0,0,0,0.06),0 1px 0 rgba(255,255,255,0.8) inset;
  transition:transform 0.3s,box-shadow 0.3s;
}
.glass:hover{transform:translateY(-4px);box-shadow:0 20px 50px rgba(139,47,201,0.12)}

/* ── HOW IT WORKS ── */
.how{background:var(--off);text-align:center}
.how-inner{max-width:1100px;margin:0 auto}
.how-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem;margin-top:3rem}
.step-card{padding:2.5rem 1.5rem;text-align:center;position:relative}
.step-num{
  width:56px;height:56px;border-radius:50%;background:var(--grad);
  display:flex;align-items:center;justify-content:center;margin:0 auto 1.2rem;
  color:#fff;font-family:'Syne',sans-serif;font-size:1.2rem;font-weight:800;
  box-shadow:0 8px 24px rgba(139,47,201,0.3);
}
.step-arrow{
  position:absolute;top:50%;right:-1rem;transform:translateY(-50%);
  color:rgba(139,47,201,0.25);font-size:1.5rem;
}
.step-icon{font-size:2.5rem;margin-bottom:0.8rem;display:block}
.step-title{font-weight:800;font-size:1.05rem;margin-bottom:0.5rem}
.step-desc{font-size:0.85rem;color:var(--muted);line-height:1.6}

/* ── SERVICES ── */
.services-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem;margin-top:3rem;max-width:1100px;margin-left:auto;margin-right:auto}
.svc-card{
  padding:1.8rem 1rem;text-align:center;cursor:pointer;
  border-radius:var(--radius);
}
.svc-card:hover .svc-icon{transform:scale(1.15) rotate(-5deg)}
.svc-icon{font-size:2.4rem;display:block;margin-bottom:0.8rem;transition:transform 0.3s}
.svc-name{font-weight:700;font-size:0.88rem;color:var(--text)}
.svc-more{
  background:var(--grad);color:#fff;border-radius:var(--radius);
  display:flex;align-items:center;justify-content:center;
  font-weight:800;font-size:0.9rem;padding:1.8rem 1rem;cursor:pointer;
  box-shadow:0 8px 24px rgba(139,47,201,0.3);
}

/* ── WORKERS ── */
.workers-section{
  background:linear-gradient(135deg,#0f0a1e 0%,#1a0a2e 50%,#0f0a1e 100%);
  color:#fff;overflow:hidden;position:relative;
}
.workers-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
.workers-section .section-label{background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.7);border-color:rgba(255,255,255,0.1)}
.workers-section .section-title{color:#fff}
.workers-section .section-desc{color:rgba(255,255,255,0.6)}
.benefit-list{list-style:none;margin-top:2rem;display:flex;flex-direction:column;gap:0.9rem}
.benefit-list li{display:flex;align-items:center;gap:0.9rem;font-size:0.95rem;color:rgba(255,255,255,0.85)}
.benefit-icon{
  width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,0.08);
  display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;
}
.workers-card{
  background:rgba(255,255,255,0.05);backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.1);border-radius:28px;
  padding:2.5rem;display:flex;flex-direction:column;gap:1.5rem;
}
.worker-stat{display:flex;align-items:center;gap:1rem}
.stat-icon{width:52px;height:52px;border-radius:14px;background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0}
.stat-val{font-family:'Syne',sans-serif;font-size:1.6rem;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.stat-lab{font-size:0.8rem;color:rgba(255,255,255,0.5);margin-top:0.1rem}
.workers-cta{
  background:var(--grad);color:#fff;border:none;
  padding:1.1rem 2.2rem;border-radius:999px;font-size:1rem;font-weight:700;
  cursor:pointer;font-family:inherit;margin-top:1rem;
  box-shadow:0 8px 30px rgba(139,47,201,0.4);transition:all 0.2s;width:fit-content;
}
.workers-cta:hover{transform:translateY(-3px);box-shadow:0 15px 40px rgba(139,47,201,0.5)}
.workers-bg-orb{position:absolute;border-radius:50%;filter:blur(100px);pointer-events:none}
.worb1{width:400px;height:400px;background:rgba(255,45,120,0.12);top:-100px;right:-100px}
.worb2{width:300px;height:300px;background:rgba(79,70,229,0.12);bottom:-50px;left:-50px}

/* ── TRUST ── */
.trust{text-align:center}
.trust-inner{max-width:900px;margin:0 auto}
.trust-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5rem;margin-top:3rem}
.trust-card{padding:2rem;text-align:center}
.trust-icon{
  width:64px;height:64px;border-radius:18px;background:var(--soft);
  display:flex;align-items:center;justify-content:center;margin:0 auto 1.2rem;
  font-size:1.8rem;border:1px solid rgba(139,47,201,0.1);
}
.trust-title{font-weight:800;font-size:1rem;margin-bottom:0.4rem}
.trust-desc{font-size:0.83rem;color:var(--muted);line-height:1.6}

/* ── WAITLIST ── */
.waitlist{
  background:linear-gradient(135deg,rgba(255,45,120,0.05) 0%,rgba(139,47,201,0.06) 50%,rgba(79,70,229,0.05) 100%);
  text-align:center;
}
.waitlist-inner{max-width:580px;margin:0 auto}
.waitlist-form{margin-top:2.5rem;display:flex;flex-direction:column;gap:1rem}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.waitlist-form input,.waitlist-form textarea{
  width:100%;padding:0.95rem 1.2rem;border-radius:14px;
  border:1.5px solid rgba(139,47,201,0.15);background:rgba(255,255,255,0.9);
  font-family:inherit;font-size:0.92rem;color:var(--text);outline:none;
  transition:border 0.2s,box-shadow 0.2s;
}
.waitlist-form input:focus,.waitlist-form textarea:focus{
  border-color:var(--purple);box-shadow:0 0 0 4px rgba(139,47,201,0.08);
}
.waitlist-form input::placeholder,.waitlist-form textarea::placeholder{color:#bbb}
.btn-waitlist{
  background:var(--grad);color:#fff;border:none;
  padding:1.05rem 2rem;border-radius:999px;font-size:1rem;font-weight:700;
  cursor:pointer;font-family:inherit;transition:all 0.2s;width:100%;
  box-shadow:0 8px 30px rgba(139,47,201,0.3);
}
.btn-waitlist:hover{transform:translateY(-2px);box-shadow:0 15px 40px rgba(139,47,201,0.4)}
.social-proof{margin-top:1.2rem;font-size:0.82rem;color:var(--muted)}
.social-proof strong{color:var(--purple)}
.avatar-row{display:flex;justify-content:center;align-items:center;gap:-6px;margin-bottom:0.4rem}
.av{
  width:32px;height:32px;border-radius:50%;border:2px solid #fff;
  background:var(--grad);margin-left:-8px;display:flex;align-items:center;justify-content:center;
  font-size:0.75rem;font-weight:700;color:#fff;
}
.av:first-child{margin-left:0}
.success-banner{display:none;background:linear-gradient(135deg,rgba(16,185,129,0.1),rgba(5,150,105,0.08));border:1px solid rgba(16,185,129,0.2);border-radius:14px;padding:1.5rem;color:#065f46;font-weight:600;font-size:0.95rem;margin-top:1rem}

/* ── FEEDBACK ── */
.feedback{background:var(--off);text-align:center}
.feedback-inner{max-width:560px;margin:0 auto}
.feedback-form{margin-top:2rem;display:flex;flex-direction:column;gap:1rem}
.feedback-form textarea{min-height:110px;resize:vertical;border-radius:14px;padding:1rem 1.2rem;border:1.5px solid rgba(139,47,201,0.15);font-family:inherit;font-size:0.92rem;outline:none;transition:border 0.2s,box-shadow 0.2s;background:rgba(255,255,255,0.9)}
.feedback-form textarea:focus{border-color:var(--purple);box-shadow:0 0 0 4px rgba(139,47,201,0.08)}
.feedback-form input{padding:0.95rem 1.2rem;border-radius:14px;border:1.5px solid rgba(139,47,201,0.15);font-family:inherit;font-size:0.92rem;outline:none;transition:border 0.2s,box-shadow 0.2s;background:rgba(255,255,255,0.9)}
.feedback-form input:focus{border-color:var(--purple);box-shadow:0 0 0 4px rgba(139,47,201,0.08)}
.feedback-form input::placeholder,.feedback-form textarea::placeholder{color:#bbb}
.btn-feedback{background:var(--grad);color:#fff;border:none;padding:1rem 2rem;border-radius:999px;font-size:0.95rem;font-weight:700;cursor:pointer;font-family:inherit;transition:all 0.2s;width:100%;box-shadow:0 6px 20px rgba(139,47,201,0.25)}
.btn-feedback:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(139,47,201,0.35)}
.fb-success{display:none;color:#065f46;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);border-radius:10px;padding:1rem;font-size:0.9rem;font-weight:600}

/* ── FOOTER ── */
footer{
  background:#0f0a1e;color:#fff;padding:3.5rem 5% 2rem;
}
.footer-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:2rem;margin-bottom:2.5rem}
.footer-brand{display:flex;align-items:center;gap:0.8rem;margin-bottom:0.8rem}
.footer-brand img{width:44px;height:44px;border-radius:10px;object-fit:cover}
.footer-brand-name{font-family:'Syne',sans-serif;font-size:1.4rem;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.footer-tagline{font-size:0.82rem;color:rgba(255,255,255,0.4);max-width:240px;line-height:1.6}
.footer-links{display:flex;gap:2rem;flex-wrap:wrap}
.footer-links a{color:rgba(255,255,255,0.5);text-decoration:none;font-size:0.85rem;transition:color 0.2s}
.footer-links a:hover{color:#fff}
.social-row{display:flex;gap:0.8rem;margin-top:0.8rem}
.soc-btn{
  width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,0.06);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  transition:background 0.2s;border:1px solid rgba(255,255,255,0.08);font-size:1rem;text-decoration:none;color:#fff;
}
.soc-btn:hover{background:rgba(139,47,201,0.3)}
.footer-bottom{border-top:1px solid rgba(255,255,255,0.06);padding-top:1.5rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}
.copyright{font-size:0.78rem;color:rgba(255,255,255,0.3)}
.footer-love{font-size:0.78rem;color:rgba(255,255,255,0.3)}
.footer-love span{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

/* ── ANIMATIONS ── */
.fade-up{opacity:0;transform:translateY(30px);transition:opacity 0.7s ease,transform 0.7s ease}
.fade-up.visible{opacity:1;transform:translateY(0)}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .workers-inner{grid-template-columns:1fr}
  .form-row{grid-template-columns:1fr}
  nav .nav-links{display:none}
  nav .nav-links.open{display:flex;flex-direction:column;position:fixed;top:70px;left:0;right:0;background:rgba(255,255,255,0.98);backdrop-filter:blur(20px);padding:2rem;gap:1.5rem;border-bottom:1px solid rgba(139,47,201,0.1)}
  .hamburger{display:flex}
  .nav-cta{display:none}
}
@media(max-width:600px){
  section{padding:4rem 4%}
  .services-grid{grid-template-columns:repeat(3,1fr)}
  .hero-btns{flex-direction:column;align-items:center}
  .footer-top{flex-direction:column}
  .footer-links{gap:1rem}
}
</style>
</head>
<body>

<!-- NAV -->
<nav id="navbar">
  <a class="nav-logo" href="#">
    <img src="data:image/jpeg;base64,
